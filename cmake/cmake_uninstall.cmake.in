set(manifest "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR "Cannot find install manifest: ${manifest}")
endif()
file(STRINGS "${manifest}" installed_files)
foreach(installed_file IN LISTS installed_files)
    set(target "$ENV{DESTDIR}${installed_file}")
    if(IS_DIRECTORY "${target}" AND NOT IS_SYMLINK "${target}")
        message(FATAL_ERROR "Refusing to remove a directory: ${target}")
    endif()
    if(EXISTS "${target}" OR IS_SYMLINK "${target}")
        execute_process(COMMAND "@CMAKE_COMMAND@" -E remove -f "${target}"
            RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot remove installed file: ${target}")
        endif()
    endif()
endforeach()
