%modern

%requires git >= 1.0
%requires ../qlib/GitDataProvider
%requires ../qlib/GitConnections.qm
%requires QUnit

%exec-class GitConnectionsTest

public class GitConnectionsTest inherits QUnit::Test {
    private {
        string m_tmpdir;
    }

    constructor() : Test("GitConnectionsTest", "1.0") {
        m_tmpdir = sprintf("%s/qore-git-conn-test-%d", ENV.TMPDIR ?? "/tmp", getpid());
        mkdir(m_tmpdir, 0700);

        addTestCase("local connection creates disk repo", \testLocalConnection());
        addTestCase("virtual connection creates virtual repo", \testVirtualConnection());
        addTestCase("local connection data provider", \testLocalDataProvider());
        addTestCase("virtual connection data provider", \testVirtualDataProvider());

        set_return_value(main());
    }

    destructor() {
        if (m_tmpdir && is_dir(m_tmpdir)) {
            system("rm -rf " + m_tmpdir);
        }
    }

    private testLocalConnection() {
        # Create a repo first
        string path = m_tmpdir + "/conn-test";
        Git::GitRepository::init(path);

        GitConnections::GitLocalConnection conn("test-local", "test", "gitlocal://" + path);
        assertEq("gitlocal", conn.getType(), "connection type is gitlocal");
        assertTrue(conn.hasDataProvider(), "local connection has data provider");

        Git::GitRepository repo = conn.get();
        assertFalse(repo.isVirtual(), "local connection creates disk repo");
    }

    private testVirtualConnection() {
        GitConnections::GitVirtualConnection conn("test-virtual", "test", "gitvirtual://myrepo");
        assertEq("gitvirtual", conn.getType(), "connection type is gitvirtual");
        assertTrue(conn.hasDataProvider(), "virtual connection has data provider");

        Git::GitRepository repo = conn.get();
        assertTrue(repo.isVirtual(), "virtual connection creates virtual repo");
    }

    private testLocalDataProvider() {
        string path = m_tmpdir + "/conn-dp-test";
        Git::GitRepository::init(path);

        GitConnections::GitLocalConnection conn("test-local-dp", "test", "gitlocal://" + path);
        AbstractDataProvider dp = conn.getDataProvider();
        assertEq("git", dp.getName(), "data provider name is 'git'");
    }

    private testVirtualDataProvider() {
        GitConnections::GitVirtualConnection conn("test-virt-dp", "test", "gitvirtual://myrepo");
        AbstractDataProvider dp = conn.getDataProvider();
        assertEq("git", dp.getName(), "data provider name is 'git'");
    }
}
