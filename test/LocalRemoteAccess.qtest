%modern

%prepend-module-path "${SCRIPT_DIR}/../build"
%prepend-module-path "${SCRIPT_DIR}/../qlib"

%requires git >= 1.0
%requires FsUtil
%requires QUnit

%exec-class LocalRemoteAccessTest

#! Tests that local remotes are checked against the file-system restrictions of the caller (module-git#9)
/** A remote whose URL is a local path or a \c file:// URL is read (fetch, pull, connectRemote()) and written (push)
    by libgit2 with its local transport.  Sandboxed code whose sandbox denies the file system by default can use only
    the remotes in the locations that its sandbox allows: read access for a fetch, read, write, create and delete access
    for a push, also when the URL is rewritten by the repository's configuration (\c insteadOf, \c pushurl), when
    the location is a working tree whose \c .git file names a git directory elsewhere, when the alternates of the
    repository's object database name other object directories, and when its references or objects are symbolic
    links elsewhere; local URLs are checked as libgit2 opens them (upper-case \c FILE:// URLs and relative paths as
    paths relative to the current directory); other remotes are refused with
    FILESYSTEM-ACCESS-DENIED before libgit2 opens them, and nothing is written to them, also with a repository that
    the sandboxed code was lent; unrestricted code uses any.
*/
class LocalRemoteAccessTest inherits QUnit::Test {
    private {
        const Modes = {"ast": EM_AST, "ir": EM_IR, "jit": EM_JIT, "tiered": EM_TIERED};

        const Source = "%modern
%requires git

# adds a remote to a repository and fetches from it after setting the given configuration
string sub fetch(Git::GitRepository repo, string name, string url, *hash<string, string> config) {
    try {
        repo.addRemote(name, url);
        map repo.configSet($1.key, $1.value), config.pairIterator();
        repo.fetch(name);
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

# adds a remote to a repository and pushes the current branch to a new branch of it after setting the given
# configuration
string sub push(Git::GitRepository repo, string name, string url, string branch, *hash<string, string> config) {
    try {
        repo.addRemote(name, url);
        map repo.configSet($1.key, $1.value), config.pairIterator();
        repo.push(name, sprintf(\"refs/heads/%s:refs/heads/%s\", repo.currentBranch(), branch));
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

# pulls from a remote of a repository
string sub pull(Git::GitRepository repo, string name) {
    try {
        repo.pull(name);
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

# opens a repository
Git::GitRepository sub open(string path) {
    return new Git::GitRepository(path);
}

# connects to a remote; returns the content of the file of the remote or the error
string sub connect(string url) {
    try {
        Git::GitRepository repo = Git::GitRepository::connectRemote(url);
        return repo.readFileString(\"file.txt\") ?? \"\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

";
    }

    private {
        #! the directory of the test
        string dir;
        #! a remote in a location that the sandbox denies
        string denied;
        #! a remote in a location that the sandbox allows to be read and written
        string allowed;
        #! a remote in a location that the sandbox allows to be read
        string readonly;
        #! bare repositories to push to, by location: local push needs a bare repository
        hash<string, string> bare;
        #! a working tree in an allowed location whose .git file names the denied remote's git directory
        string redirect;
        #! a repository in the allowed location whose alternates name the denied remote's object database
        string alternates;
        #! the same with a relative alternates entry
        string relative_alternates;
        #! a repository in the allowed location whose alternates name the alternates repository
        string nested_alternates;
        #! a bare repository in the allowed location whose refs directory is a symbolic link to the denied one's
        string symlinked_refs;
        #! a bare repository in the allowed location whose objects directory is a symbolic link to the denied one's
        string symlinked_objects;
        #! the location of the repositories of the sandboxed code
        string work;
        #! a counter for unique names
        int n;
    }

    constructor() : QUnit::Test("LocalRemoteAccess", "1.0", \ARGV) {
        dir = make_tmp_dir("git-local-remote-");
        mkdir(dir + "/denied");
        mkdir(dir + "/allowed");
        mkdir(dir + "/ro");
        mkdir(dir + "/work");
        denied = makeRepo(dir + "/denied/remote", "denied\n");
        allowed = makeRepo(dir + "/allowed/remote", "allowed\n");
        readonly = makeRepo(dir + "/ro/remote", "readonly\n");
        mkdir(dir + "/rw");
        foreach string loc in ("denied", "allowed", "ro", "rw") {
            bare{loc} = sprintf("%s/%s/bare.git", dir, loc);
            Git::GitRepository::init(bare{loc}, True);
        }
        # repositories in the allowed location whose object database or references are elsewhere
        alternates = makeRepo(dir + "/allowed/alternates", "alternates\n");
        writeFile(alternates + "/.git/objects/info/alternates", "# comment\n\n" + denied + "/.git/objects\n");
        relative_alternates = makeRepo(dir + "/allowed/relative-alternates", "relative\n");
        writeFile(relative_alternates + "/.git/objects/info/alternates", "../../../../denied/remote/.git/objects\n");
        nested_alternates = makeRepo(dir + "/allowed/nested-alternates", "nested\n");
        writeFile(nested_alternates + "/.git/objects/info/alternates", alternates + "/.git/objects\n");
        symlinked_refs = dir + "/allowed/symlinked-refs.git";
        Git::GitRepository::init(symlinked_refs, True);
        remove_tree(symlinked_refs + "/refs");
        symlink(bare.denied + "/refs", symlinked_refs + "/refs");
        symlinked_objects = dir + "/allowed/symlinked-objects.git";
        Git::GitRepository::init(symlinked_objects, True);
        remove_tree(symlinked_objects + "/objects");
        symlink(bare.denied + "/objects", symlinked_objects + "/objects");
        redirect = dir + "/allowed/redirect";
        mkdir(redirect);
        File f();
        f.open2(redirect + "/.git", O_CREAT | O_WRONLY | O_TRUNC);
        f.write("gitdir: " + denied + "/.git\n");
        f.close();
        work = dir + "/work";

        foreach string mode in (keys Modes) {
            string m = mode;
            addTestCase("fetch, " + m, sub () { testFetch(m); });
            addTestCase("push, " + m, sub () { testPush(m); });
            addTestCase("pull and connectRemote, " + m, sub () { testPullConnect(m); });
        }
        set_return_value(main());
    }

    destructor() {
        if (dir) {
            remove_tree(dir);
        }
    }

    private testFetch(string mode) {
        Program p = getProgram("sandbox", mode);
        foreach string url in (denied, "file://" + denied, "file://localhost" + denied, "file://" + denied + "/.git",
                "file://" + regex_subst(denied, "/remote$", "/%72emote"), dir + "/allowed/../denied/remote", redirect,
                getRelativePath(denied), "FILE://" + denied, "file://LOCALHOST" + denied, "File://" + allowed,
                alternates, "file://" + relative_alternates, nested_alternates, symlinked_objects) {
            assertEq("FILESYSTEM-ACCESS-DENIED", p.callFunction("fetch", getWorkRepo(p), "r", url),
                sprintf("fetch %y %s", url, mode));
        }
        # the URL that libgit2 uses after the rewriting of the repository's configuration
        assertEq("FILESYSTEM-ACCESS-DENIED", p.callFunction("fetch", getWorkRepo(p), "r", "alias://remote",
            {sprintf("url.file://%s/.insteadOf", dir + "/denied"): "alias://"}), "fetch insteadOf " + mode);
        # the sandboxed code changes the URL of a remote itself
        assertEq("FILESYSTEM-ACCESS-DENIED", p.callFunction("fetch", getWorkRepo(p), "r", allowed,
            {"remote.r.url": denied}), "fetch changed url " + mode);
        # a network remote is still checked against the network policy
        assertEq("NETWORK-ACCESS-DENIED", p.callFunction("fetch", getWorkRepo(p), "r",
            "https://nonexistent.invalid/repo.git"), "fetch network " + mode);
        # the remotes in allowed locations
        foreach string url in (allowed, "file://" + allowed, readonly, "file://" + readonly,
                getRelativePath(allowed)) {
            assertEq("ok", p.callFunction("fetch", getWorkRepo(p), "r", url), sprintf("fetch %y %s", url, mode));
        }
        # a remote of a lent repository
        assertEq("FILESYSTEM-ACCESS-DENIED", p.callFunction("fetch", new Git::GitRepository(getWorkRepoPath()),
            "r", denied), "lent fetch " + mode);
        # an unrestricted caller uses any remote
        assertEq("ok", getProgram("unrestricted", mode).callFunction("fetch", new Git::GitRepository(
            getWorkRepoPath()), "r", denied), "unrestricted fetch " + mode);
    }

    private testPush(string mode) {
        Program p = getProgram("sandbox", mode);
        foreach hash<auto> i in ((
                {"url": bare.denied, "result": "FILESYSTEM-ACCESS-DENIED", "remote": bare.denied},
                {"url": "file://" + bare.denied, "result": "FILESYSTEM-ACCESS-DENIED", "remote": bare.denied},
                {"url": bare.ro, "result": "FILESYSTEM-ACCESS-DENIED", "remote": bare.ro},
                {"url": bare.allowed, "result": "ok", "remote": bare.allowed},
                {"url": "file://" + bare.allowed, "result": "ok", "remote": bare.allowed},
                {"url": bare.allowed, "config": {"remote.r.pushurl": bare.denied},
                    "result": "FILESYSTEM-ACCESS-DENIED", "remote": bare.denied},
                {"url": "alias://bare.git", "config": {sprintf("url.%s/.pushInsteadOf", dir + "/denied"): "alias://"},
                    "result": "FILESYSTEM-ACCESS-DENIED", "remote": bare.denied},
                # the local transport writes the repository of the URL, not of the push URL
                {"url": bare.denied, "config": {"remote.r.pushurl": bare.allowed},
                    "result": "FILESYSTEM-ACCESS-DENIED", "remote": bare.denied},
                # a location that may be read and written, but in which no file may be created
                {"url": bare.rw, "result": "FILESYSTEM-ACCESS-DENIED", "remote": bare.rw},
                # references and objects that are symbolic links to the denied repository's
                {"url": symlinked_refs, "result": "FILESYSTEM-ACCESS-DENIED", "remote": bare.denied},
                {"url": symlinked_objects, "result": "FILESYSTEM-ACCESS-DENIED", "remote": bare.denied},
            )) {
            string branch = sprintf("pushed-%s-%d", mode, ++n);
            string desc = sprintf("push %y %y %s", i.url, i.config, mode);
            assertEq(i.result, p.callFunction("push", getCommittedWorkRepo(p), "r", i.url, branch, i.config), desc);
            # nothing is written to a remote that is refused
            assertEq(i.result == "ok", inlist(branch, getBranches(i.remote)), desc + " branch");
        }
    }

    private testPullConnect(string mode) {
        Program p = getProgram("sandbox", mode);
        foreach string url in (denied, "file://" + denied, redirect) {
            assertEq("FILESYSTEM-ACCESS-DENIED", p.callFunction("connect", url), sprintf("connectRemote %y %s", url,
                mode));
        }
        assertEq("allowed\n", p.callFunction("connect", "file://" + allowed), "connectRemote allowed " + mode);
        assertEq("readonly\n", p.callFunction("connect", readonly), "connectRemote readonly " + mode);

        # a repository of the sandboxed code that tracks a remote that the host changed to a denied location
        string path = getWorkRepoPath();
        {
            Git::GitRepository repo = Git::GitRepository::connectRemote(allowed);
            repo.writeFileString("x", "x");
        }
        Git::GitRepository repo = p.callFunction("open", cloneTo(allowed, path));
        assertEq("ok", p.callFunction("pull", repo, "origin"), "pull allowed " + mode);
        repo.configSet("remote.origin.url", denied);
        assertEq("FILESYSTEM-ACCESS-DENIED", p.callFunction("pull", repo, "origin"), "pull denied " + mode);
    }

    #! returns a path relative to the current directory that names the given absolute path
    private string getRelativePath(string path) {
        int depth = (select getcwd().split("/"), $1.val()).size();
        return strmul("../", depth) + path.substr(1);
    }

    #! writes a file
    private writeFile(string path, string content) {
        File f();
        f.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(content);
    }

    #! returns the branches of a repository
    private list<string> getBranches(string path) {
        return (new Git::GitRepository(path)).branches();
    }

    #! creates a repository that tracks the given remote as origin in the given location
    private string cloneTo(string url, string path) {
        Git::GitRepository repo = Git::GitRepository::init(path);
        repo.addRemote("origin", url);
        repo.fetch("origin");
        string branch = (new Git::GitRepository(url)).currentBranch();
        repo.checkout("origin/" + branch);
        repo.createBranch(branch, "origin/" + branch);
        repo.checkout(branch);
        repo.configSet(sprintf("branch.%s.remote", branch), "origin");
        repo.configSet(sprintf("branch.%s.merge", branch), "refs/heads/" + branch);
        return path;
    }

    #! returns a new empty repository in the work location, opened by the sandboxed code
    private Git::GitRepository getWorkRepo(Program p) {
        return p.callFunction("open", getWorkRepoPath());
    }

    #! returns a new repository with a commit in the work location, opened by the sandboxed code
    private Git::GitRepository getCommittedWorkRepo(Program p) {
        string path = getWorkRepoPath();
        Git::GitRepository repo(path);
        repo.configSet("user.name", "Test");
        repo.configSet("user.email", "test@example.com");
        repo.writeFileString("work.txt", "work\n");
        repo.commit("work");
        return p.callFunction("open", path);
    }

    #! creates a new empty repository in the work location
    private string getWorkRepoPath() {
        string path = sprintf("%s/repo-%d", work, ++n);
        Git::GitRepository::init(path);
        return path;
    }

    #! creates a repository with one committed file
    private string makeRepo(string path, string content) {
        Git::GitRepository repo = Git::GitRepository::init(path);
        repo.configSet("user.name", "Test");
        repo.configSet("user.email", "test@example.com");
        repo.writeFileString("file.txt", content);
        repo.commit("initial");
        return path;
    }

    #! returns a Program of the given kind
    private Program getProgram(string kind, string mode) {
        Program p;
        switch (kind) {
            case "sandbox": {
                SandboxManager sm();
                sm.setFilesystemDefaultPolicy(False);
                sm.addFilesystemAllowedPath(dir + "/allowed", QSEC_ALL);
                sm.addFilesystemAllowedPath(dir + "/work", QSEC_ALL);
                sm.addFilesystemAllowedPath(dir + "/ro", QSEC_READ);
                sm.addFilesystemAllowedPath(dir + "/rw", QSEC_READ | QSEC_WRITE);
                p = new Program(PO_NEW_STYLE);
                p.setSandboxManager(sm);
                break;
            }
            default:
                p = new Program(PO_NEW_STYLE);
                break;
        }
        p.setExecMode(Modes{mode});
        p.parse(Source, kind);
        return p;
    }
}
