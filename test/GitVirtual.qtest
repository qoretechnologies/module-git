%modern

%requires git >= 1.0
%requires QUnit

%exec-class GitVirtualTest

public class GitVirtualTest inherits QUnit::Test {
    constructor() : Test("GitVirtualTest", "1.0") {
        addTestCase("create virtual repo", \testCreateVirtual());
        addTestCase("write and read files", \testWriteReadFiles());
        addTestCase("write and read string files", \testWriteReadStringFiles());
        addTestCase("file operations", \testFileOperations());
        addTestCase("commit in virtual mode", \testCommit());
        addTestCase("multiple commits", \testMultipleCommits());
        addTestCase("nested directory structure", \testNestedDirectories());
        addTestCase("binary file round-trip", \testBinaryRoundTrip());
        addTestCase("disk mode add() rejected in virtual", \testModeErrors());
        addTestCase("named argument calls", \testNamedArguments());
        addTestCase("named argument surface parses", \testNamedArgumentSurfaceParses());
        set_return_value(main());
    }

    private testCreateVirtual() {
        Git::GitRepository repo = Git::GitRepository::createVirtual();
        assertEq(True, repo.isVirtual(), "isVirtual() returns True");
        assertEq(True, repo.isEmpty(), "virtual repo is empty initially");
        assertEq(True, repo.isBare(), "virtual repo is conceptually bare");
        assertNothing(repo.workdir(), "virtual repo has no workdir");
        assertEq("<virtual>", repo.path(), "virtual repo path is <virtual>");
    }

    private testWriteReadFiles() {
        Git::GitRepository repo = Git::GitRepository::createVirtual();

        # Write binary content
        binary data = binary("Hello, World!\n");
        repo.writeFile("test.txt", data);

        # Read it back
        *binary read_data = repo.readFile("test.txt");
        assertEq(data, read_data, "readFile returns same binary content");
    }

    private testWriteReadStringFiles() {
        Git::GitRepository repo = Git::GitRepository::createVirtual();

        string content = "pool_size: 10\ntimeout: 30\n";
        repo.writeFileString("config/db.yaml", content);

        *string read_content = repo.readFileString("config/db.yaml");
        assertEq(content, read_content, "readFileString returns same content");
    }

    private testFileOperations() {
        Git::GitRepository repo = Git::GitRepository::createVirtual();

        # File doesn't exist initially
        assertEq(False, repo.fileExists("missing.txt"), "non-existent file returns False");

        # Write a file
        repo.writeFileString("test.txt", "content");
        assertEq(True, repo.fileExists("test.txt"), "file exists after write");

        # List files
        list<string> files = repo.listFiles();
        assertEq(1, files.size(), "listFiles returns 1 file");
        assertEq("test.txt", files[0], "listFiles returns correct filename");

        # Delete the file
        repo.deleteFile("test.txt");
        assertEq(False, repo.fileExists("test.txt"), "file gone after delete");

        # List should be empty
        files = repo.listFiles();
        assertEq(0, files.size(), "listFiles empty after delete");
    }

    private testCommit() {
        Git::GitRepository repo = Git::GitRepository::createVirtual();
        repo.configSet("user.name", "Virtual User");
        repo.configSet("user.email", "virtual@test.com");

        # Write and commit
        repo.writeFileString("readme.txt", "Hello\n");
        string oid = repo.commit("Initial commit");

        assertEq(40, oid.length(), "commit returns 40-char hex OID");
        assertRegex("^[0-9a-f]{40}$", oid, "commit OID is valid hex");
        assertEq(False, repo.isEmpty(), "repo not empty after commit");

        # HEAD should match
        *string head = repo.headCommitId();
        assertEq(oid, head, "headCommitId matches commit OID");
    }

    private testMultipleCommits() {
        Git::GitRepository repo = Git::GitRepository::createVirtual();
        repo.configSet("user.name", "Test");
        repo.configSet("user.email", "test@test.com");

        # First commit
        repo.writeFileString("file1.txt", "first\n");
        string oid1 = repo.commit("First commit");

        # Second commit (add another file)
        repo.writeFileString("file2.txt", "second\n");
        string oid2 = repo.commit("Second commit");

        assertNeq(oid1, oid2, "different commits have different OIDs");
        assertEq(oid2, repo.headCommitId(), "HEAD points to latest commit");
    }

    private testNestedDirectories() {
        Git::GitRepository repo = Git::GitRepository::createVirtual();
        repo.configSet("user.name", "Test");
        repo.configSet("user.email", "test@test.com");

        # Write files in nested structure
        repo.writeFileString("config/database/main.yaml", "host: localhost\n");
        repo.writeFileString("config/database/replica.yaml", "host: replica\n");
        repo.writeFileString("config/services/api.yaml", "port: 8080\n");
        repo.writeFileString("readme.txt", "Root file\n");

        # Commit
        string oid = repo.commit("Add nested config");
        assertEq(40, oid.length(), "nested commit succeeds");

        # Read back nested files
        *string main_db = repo.readFileString("config/database/main.yaml");
        assertEq("host: localhost\n", main_db, "nested file content correct");

        *string api = repo.readFileString("config/services/api.yaml");
        assertEq("port: 8080\n", api, "nested file in different dir correct");

        # List files — virtual tree should contain all written files
        list<string> files = repo.listFiles();
        assertTrue(files.size() >= 4, "at least 4 files in virtual tree");
    }

    private testBinaryRoundTrip() {
        Git::GitRepository repo = Git::GitRepository::createVirtual();
        repo.configSet("user.name", "Test");
        repo.configSet("user.email", "test@test.com");

        # Create binary content with null bytes
        binary data = <0102030000050607>;
        repo.writeFile("data.bin", data);

        # Read back before commit
        *binary read = repo.readFile("data.bin");
        assertEq(data, read, "binary content preserved before commit");

        # Commit and read back
        repo.commit("Add binary file");
        # After commit, the file should still be readable from the virtual tree
        # (virtual tree persists across commits)
        *binary read2 = repo.readFile("data.bin");
        assertEq(data, read2, "binary content preserved after commit");
    }

    private testModeErrors() {
        Git::GitRepository repo = Git::GitRepository::createVirtual();

        # add() should fail in virtual mode
        assertThrows("GIT-MODE-ERROR", \repo.add(), ("test.txt",),
            "add() throws GIT-MODE-ERROR in virtual mode");

        # unstage() should fail in virtual mode
        assertThrows("GIT-MODE-ERROR", \repo.unstage(), ("test.txt",),
            "unstage() throws GIT-MODE-ERROR in virtual mode");
    }

    private testNamedArguments() {
        Git::GitRepository repo = Git::GitRepository::createVirtual();
        repo.configSet(key: "user.name", value: "Named User");
        repo.configSet(key: "user.email", value: "named@test.com");
        assertEq("Named User", repo.configGet(key: "user.name"), "configGet() accepts named arguments");

        repo.writeFileString(path: "config/db.yaml", content: "pool_size: 10\n");
        assertEq("pool_size: 10\n", repo.readFileString(path: "config/db.yaml", encoding: NOTHING),
            "readFileString() accepts named arguments");

        binary data = <01020304>;
        repo.writeFile(path: "data.bin", content: data);
        assertEq(data, repo.readFile(path: "data.bin"), "binary file calls accept named arguments");
        assertTrue(repo.fileExists(path: "data.bin"), "fileExists() accepts named arguments");

        string first = repo.commit(message: "Initial named commit");
        assertEq(first, repo.lookupCommit(ref: first).id, "lookupCommit() accepts named arguments");

        repo.writeFileString(path: "config/db.yaml", content: "pool_size: 12\n");
        string second = repo.commit(message: "Update named commit");

        list<hash<auto>> changes = repo.diff(from_ref: first, to_ref: second);
        assertEq(1, changes.size(), "diff() accepts named arguments");

        string patch = repo.diffPatch(from_ref: first, to_ref: second);
        assertTrue(patch.find("+pool_size: 12") >= 0, "diffPatch() accepts named arguments");

        list<hash<auto>> commits = repo.log(max_count: 2, path: NOTHING);
        assertEq(2, commits.size(), "log() accepts named arguments");

        hash<auto> stats = repo.diffStats(from_ref: first, to_ref: second);
        assertEq(1, stats.files_changed, "diffStats() accepts named arguments");

        repo.createBranch(name: "named-branch", from_ref: second);
        assertTrue(repo.branches(remote: False).contains("named-branch"), "branch calls accept named arguments");

        repo.createTag(name: "named-tag", message: NOTHING, target_ref: second);
        assertTrue(repo.tags().contains("named-tag"), "createTag() accepts named arguments");
        repo.deleteTag(name: "named-tag");

        repo.writeFileString(path: "scratch.txt", content: "temporary\n");
        assertTrue(repo.fileExists(path: "scratch.txt"), "scratch file exists before named delete");
        repo.deleteFile(path: "scratch.txt");
        assertEq(False, repo.fileExists(path: "scratch.txt"), "deleteFile() accepts named arguments");
    }

    private testNamedArgumentSurfaceParses() {
        Program p(PO_NEW_STYLE);
        p.loadModule("git");
        p.parse("
sub named_git_repository_calls() {
    Git::GitRepository repo = Git::GitRepository::createVirtual();
    Git::GitRepository disk_repo(path: '/tmp/qore-module-git-named');
    Git::GitRepository initialized = Git::GitRepository::init(path: '/tmp/qore-module-git-init', bare: False);

    repo.writeFileString(path: 'file.txt', content: 'content');
    repo.writeFile(path: 'file.bin', content: <0102>);
    *string text = repo.readFileString(path: 'file.txt', encoding: NOTHING);
    *binary bytes = repo.readFile(path: 'file.bin');
    bool has_file = repo.fileExists(path: 'file.txt');
    repo.add(path: 'file.txt');
    repo.unstage(path: 'file.txt');
    string oid = repo.commit(message: 'commit');
    repo.configSet(key: 'user.name', value: 'User');
    *string cfg = repo.configGet(key: 'user.name');
    repo.createBranch(name: 'feature', from_ref: oid);
    repo.deleteBranch(name: 'feature');
    repo.checkout(ref: 'main');
    list<string> branch_names = repo.branches(remote: False);
    repo.createTag(name: 'v1.0', message: NOTHING, target_ref: oid);
    repo.deleteTag(name: 'v1.0');
    list<hash<auto>> changes = repo.diff(from_ref: NOTHING, to_ref: oid);
    string patch = repo.diffPatch(from_ref: NOTHING, to_ref: oid);
    list<hash<auto>> entries = repo.log(max_count: 10, path: NOTHING);
    repo.addRemote(name: 'origin', url: 'https://example.invalid/repo.git');
    repo.removeRemote(name: 'origin');
    repo.fetch(remote: 'origin');
    repo.push(remote: 'origin', refspec: 'refs/heads/main:refs/heads/main');
    hash<auto> commit_info = repo.lookupCommit(ref: oid);
    hash<auto> diff_stats = repo.diffStats(from_ref: NOTHING, to_ref: oid);
    list<hash<auto>> blame_hunks = repo.blame(path: 'file.txt', options: NOTHING);
    string stash_oid = repo.stash(message: 'work in progress');
    Git::GitRepository remote_repo = Git::GitRepository::connectRemote(url: 'https://example.invalid/repo.git',
        options: NOTHING);
    hash<auto> merge_result = repo.merge(ref: 'main', options: NOTHING);
    hash<auto> pull_result = repo.pull(remote: 'origin', options: NOTHING);
}
", "git-named-arguments");
    }
}
