%modern

%requires GitForgeHelper
%requires QUnit

%exec-class GitForgeHelperTest

public class GitForgeHelperTest inherits QUnit::Test {
    constructor() : Test("GitForgeHelperTest", "1.0") {
        addTestCase("github helper creation", \testGitHubCreation());
        addTestCase("gitlab helper creation", \testGitLabCreation());
        addTestCase("invalid forge type", \testInvalidForge());
        addTestCase("missing required options", \testMissingOptions());
        addTestCase("forge type accessor", \testForgeType());

        set_return_value(main());
    }

    private testGitHubCreation() {
        GitForgeHelper::GitForgeHelper helper("github", {
            "owner": "testorg",
            "repo": "testrepo",
            "token": "test-token",
        });
        assertEq("github", helper.getForgeType(), "github forge type set");
    }

    private testGitLabCreation() {
        GitForgeHelper::GitForgeHelper helper("gitlab", {
            "owner": "testgroup",
            "repo": "testrepo",
            "token": "test-token",
            "url": "https://gitlab.example.com",
        });
        assertEq("gitlab", helper.getForgeType(), "gitlab forge type set");
    }

    private testInvalidForge() {
        assertThrows("GIT-FORGE-ERROR",
            sub () {
                new GitForgeHelper::GitForgeHelper("bitbucket", {
                    "owner": "test",
                    "repo": "test",
                    "token": "test",
                });
            },
            NOTHING,
            "invalid forge type throws");
    }

    private testMissingOptions() {
        # Missing owner
        assertThrows("GIT-FORGE-ERROR",
            sub () {
                new GitForgeHelper::GitForgeHelper("github", {
                    "repo": "test",
                    "token": "test",
                });
            },
            NOTHING,
            "missing owner throws");

        # Missing repo
        assertThrows("GIT-FORGE-ERROR",
            sub () {
                new GitForgeHelper::GitForgeHelper("github", {
                    "owner": "test",
                    "token": "test",
                });
            },
            NOTHING,
            "missing repo throws");

        # Missing token
        assertThrows("GIT-FORGE-ERROR",
            sub () {
                new GitForgeHelper::GitForgeHelper("github", {
                    "owner": "test",
                    "repo": "test",
                });
            },
            NOTHING,
            "missing token throws");
    }

    private testForgeType() {
        GitForgeHelper::GitForgeHelper gh("github", {
            "owner": "o", "repo": "r", "token": "t",
        });
        assertEq("github", gh.getForgeType(), "getForgeType returns github");

        GitForgeHelper::GitForgeHelper gl("gitlab", {
            "owner": "o", "repo": "r", "token": "t",
        });
        assertEq("gitlab", gl.getForgeType(), "getForgeType returns gitlab");
    }
}
