%modern

%requires git >= 1.0
%requires GitConfigManager
%requires QUnit

%exec-class GitConfigManagerTest

public class GitConfigManagerTest inherits QUnit::Test {
    private {
        string m_tmpdir;
    }

    constructor() : Test("GitConfigManagerTest", "1.0") {
        m_tmpdir = sprintf("%s/qore-git-cfgmgr-test-%d", ENV.TMPDIR ?? "/tmp", getpid());
        mkdir(m_tmpdir, 0700);
        addTestCase("read/write config", \testReadWriteConfig());
        addTestCase("delete config", \testDeleteConfig());
        addTestCase("list configs", \testListConfigs());
        addTestCase("publish (commit)", \testPublish());
        addTestCase("environments (branches)", \testEnvironments());
        addTestCase("history", \testHistory());
        addTestCase("tags", \testTags());
        addTestCase("pending changes", \testPendingChanges());
        addTestCase("identity", \testIdentity());
        addTestCase("sync with local bare repo", \testSync());

        set_return_value(main());
    }

    destructor() {
        if (m_tmpdir && is_dir(m_tmpdir)) {
            system("rm -rf " + m_tmpdir);
        }
    }

    private GitConfigManager::GitConfigManager setupMgr() {
        Git::GitRepository repo = Git::GitRepository::createVirtual();
        repo.configSet("user.name", "ConfigBot");
        repo.configSet("user.email", "bot@test.com");
        return new GitConfigManager::GitConfigManager(repo);
    }

    private testReadWriteConfig() {
        GitConfigManager::GitConfigManager mgr = setupMgr();

        mgr.writeConfig("config/app.yaml", "port: 8080\n");
        *string content = mgr.readConfig("config/app.yaml");
        assertEq("port: 8080\n", content, "read returns written content");

        # Non-existent file
        *string missing = mgr.readConfig("nonexistent.yaml");
        assertNothing(missing, "non-existent config returns NOTHING");
    }

    private testDeleteConfig() {
        GitConfigManager::GitConfigManager mgr = setupMgr();

        mgr.writeConfig("temp.txt", "temporary\n");
        assertTrue(mgr.configExists("temp.txt"), "config exists after write");

        mgr.deleteConfig("temp.txt");
        assertFalse(mgr.configExists("temp.txt"), "config gone after delete");
    }

    private testListConfigs() {
        GitConfigManager::GitConfigManager mgr = setupMgr();

        mgr.writeConfig("a.yaml", "a\n");
        mgr.writeConfig("b.yaml", "b\n");
        mgr.writeConfig("dir/c.yaml", "c\n");

        list<string> configs = mgr.listConfigs();
        assertEq(3, configs.size(), "3 config files listed");
    }

    private testPublish() {
        GitConfigManager::GitConfigManager mgr = setupMgr();

        mgr.writeConfig("init.yaml", "version: 1\n");
        hash<auto> result = mgr.publish("Initial config");
        assertEq(40, result.id.size(), "publish returns 40-char commit ID");

        # Verify the file persists after commit
        *string content = mgr.readConfig("init.yaml");
        assertEq("version: 1\n", content, "config readable after publish");
    }

    private testEnvironments() {
        GitConfigManager::GitConfigManager mgr = setupMgr();

        # Need initial commit for branches to work
        mgr.writeConfig("base.yaml", "base\n");
        mgr.publish("Initial");

        # Create and switch to staging environment
        mgr.createEnvironment("staging");
        mgr.switchEnvironment("staging");
        assertEq("staging", mgr.currentEnvironment(), "current env is staging");

        # Write config on staging branch
        mgr.writeConfig("staging.yaml", "env: staging\n");
        mgr.publish("Add staging config");

        # Switch back to main
        mgr.switchEnvironment("main");
        assertEq("main", mgr.currentEnvironment(), "back to main");

        # List environments
        list<string> envs = mgr.environments();
        assertTrue(envs.size() >= 2, "at least 2 environments");
    }

    private testHistory() {
        GitConfigManager::GitConfigManager mgr = setupMgr();

        mgr.writeConfig("f1.txt", "a\n");
        mgr.publish("First");

        mgr.writeConfig("f2.txt", "b\n");
        mgr.publish("Second");

        list<hash<auto>> hist = mgr.history();
        assertEq(2, hist.size(), "2 commits in history");

        # Limited history
        list<hash<auto>> limited = mgr.history(1);
        assertEq(1, limited.size(), "limited history returns 1");
    }

    private testTags() {
        GitConfigManager::GitConfigManager mgr = setupMgr();

        mgr.writeConfig("v1.yaml", "version: 1\n");
        mgr.publish("Version 1");
        mgr.tagState("v1.0", "Release v1.0");

        list<string> tags = mgr.listTags();
        assertEq(1, tags.size(), "1 tag");
        assertEq("v1.0", tags[0], "tag name correct");
    }

    private testPendingChanges() {
        GitConfigManager::GitConfigManager mgr = setupMgr();

        hash<auto> empty = mgr.pendingChanges();
        assertEq(0, empty.size(), "no pending changes initially");

        mgr.writeConfig("pending.yaml", "data\n");
        hash<auto> pending = mgr.pendingChanges();
        assertTrue(pending.size() > 0, "has pending changes after write");
        assertTrue(pending.hasKey("pending.yaml"), "pending.yaml in changes");
    }

    private testIdentity() {
        GitConfigManager::GitConfigManager mgr = setupMgr();

        mgr.setIdentity("New Author", "author@example.com");
        mgr.writeConfig("f.txt", "content\n");
        mgr.publish("Test identity");

        list<hash<auto>> hist = mgr.history();
        assertEq("New Author", hist[0].author.name, "identity name set correctly");
        assertEq("author@example.com", hist[0].author.email, "identity email set correctly");
    }

    private testSync() {
        # Create a bare "server" repo with a commit
        string bare_path = m_tmpdir + "/cfg-server.git";
        Git::GitRepository bare = Git::GitRepository::init(bare_path, True);

        string setup_path = m_tmpdir + "/cfg-setup";
        Git::GitRepository setup = Git::GitRepository::init(setup_path);
        setup.configSet("user.name", "Setup");
        setup.configSet("user.email", "setup@test.com");
        setup.addRemote("origin", bare_path);
        {
            File f();
            f.open(setup_path + "/config.yaml", O_CREAT | O_WRONLY | O_TRUNC);
            f.write("key: value\n");
        }
        setup.add("config.yaml");
        setup.commit("Initial config");
        setup.push();

        # Create a virtual config manager pointing at the bare repo
        Git::GitRepository repo = Git::GitRepository::createVirtual();
        repo.configSet("user.name", "SyncBot");
        repo.configSet("user.email", "sync@test.com");
        repo.addRemote("origin", bare_path);
        GitConfigManager::GitConfigManager mgr(repo);

        # Sync fetches from remote — HEAD stays unborn until checkout
        hash<auto> result = mgr.sync();
        # Both old_head and new_head are NOTHING (HEAD is unborn in virtual repo)
        assertFalse(result.changes, "no HEAD change on fetch alone");

        # Checkout the remote branch to update HEAD (via manager to keep last_head_id in sync)
        list<string> remote_branches = repo.branches(True);
        assertTrue(remote_branches.size() > 0, "remote branches fetched");
        mgr.switchEnvironment(remote_branches[0]);

        # Verify we can read the config after sync + checkout
        *string content = mgr.readConfig("config.yaml");
        assertEq("key: value\n", content, "config readable after sync + checkout");

        # Now sync again — no new commits on remote, so no changes
        hash<auto> result2 = mgr.sync();
        assertFalse(result2.changes, "no changes on second sync");
    }
}
