%requires qore >= 2.0
%modern

%requires(reexport) git
%requires(reexport) ConnectionProvider

/** @mainpage GitConnections Module

    @section gitconnectionsintro GitConnections Module Introduction

    The \c GitConnections module provides connection management for git repositories.

    @since 1.0
*/

module GitConnections {
    version = "1.0";
    desc = "user module for git connection management";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

