%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) git

module GitConfigManager {
    version = "1.0";
    desc = "user module for high-level git-based configuration management with observer pattern";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

public namespace GitConfigManager {
    #! Event fired when config files change during sync
    public const EVENT_CONFIG_CHANGED = "config-changed";

    #! Event fired when unresolved merge conflicts are detected
    public const EVENT_CONFIG_CONFLICT = "config-conflict";
}

/** @mainpage GitConfigManager Module

    @section gitconfigmanagerintro GitConfigManager Module Introduction

    The \c GitConfigManager module provides high-level git-based configuration management
    with observer pattern support for reactive change detection.

    It wraps a \c GitRepository (virtual or disk-backed) and provides:
    - Config file read/write with automatic staging
    - Sync (fetch + detect changes) and publish (commit + push)
    - Environment/branch management
    - Observer-based change notification via \c GitConfigWatcher

    @since 1.0
*/
