%modern

%requires(reexport) RestClient
%requires(reexport) git

/** @mainpage GitForgeHelper Module

    @section gitforgehelperintro GitForgeHelper Module Introduction

    The \c GitForgeHelper module provides integration with GitHub and GitLab for
    pull request and merge request management.

    @since 1.0
*/

module GitForgeHelper {
    version = "1.0";
    desc = "user module for GitHub/GitLab pull request and merge request management";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

