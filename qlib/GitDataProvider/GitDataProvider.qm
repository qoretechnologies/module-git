%requires qore >= 2.0
%modern

%requires(reexport) DataProvider
%requires(reexport) git

/** @mainpage GitDataProvider Module

    @section gitdataproviderintro GitDataProvider Module Introduction

    The \c GitDataProvider module provides a data provider API for git repository operations,
    supporting both disk-backed and virtual (in-memory) repositories.

    The following data provider actions are available:

    - \c read-file: Read a file from the repository
    - \c write-file: Write a file to the repository
    - \c list-files: List files in the repository
    - \c commit: Create a commit
    - \c log: Retrieve commit history
    - \c status: Get repository status

    @since 1.0
*/

module GitDataProvider {
    version = "1.0";
    desc = "user module providing a data provider API for Git repositories";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # Register the data provider factory
        DataProvider::registerFactory(new GitDataProviderFactory());
    };
}

public namespace GitDataProvider {
    # App name constant
    public const AppName = "Git";
}
