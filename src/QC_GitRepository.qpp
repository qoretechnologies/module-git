#include "git-module.h"
#include "QC_GitRepository.h"
#include "QoreGitRepository.h"

//! Git signature (author/committer) information
/** @since git 1.0
*/
hashdecl Qore::Git::GitSignatureInfo {
    //! Author or committer name
    string name;

    //! Author or committer email
    string email;

    //! Timestamp
    date when;
}

//! Commit information as returned by @ref GitRepository::log() "log()" and @ref GitRepository::lookupCommit() "lookupCommit()"
/** @since git 1.0
*/
hashdecl Qore::Git::CommitInfo {
    //! Full hex OID of the commit (40 characters)
    string id;

    //! Short hex OID (7 characters)
    string short_id;

    //! Full commit message
    string message;

    //! First line of the commit message
    string summary;

    //! Author signature
    hash<GitSignatureInfo> author;

    //! Committer signature
    hash<GitSignatureInfo> committer;

    //! Number of parent commits (0 for root, 1 for normal, 2+ for merge)
    int parent_count;

    //! List of parent commit OIDs
    *list<string> parent_ids;
}

//! Diff entry as returned by @ref GitRepository::diff() "diff()"
/** @since git 1.0
*/
hashdecl Qore::Git::DiffEntry {
    //! Change status: "added", "deleted", "modified", "renamed"
    string status;

    //! File path
    string path;

    //! Old file path (for renames)
    *string old_path;
}

//! Diff statistics as returned by @ref GitRepository::diffStats() "diffStats()"
/** @since git 1.0
*/
hashdecl Qore::Git::DiffStatsInfo {
    //! Number of files changed
    int files_changed;

    //! Total lines inserted
    int insertions;

    //! Total lines deleted
    int deletions;
}

//! Blame hunk information as returned by @ref GitRepository::blame() "blame()"
/** @since git 1.0
*/
hashdecl Qore::Git::BlameHunkInfo {
    //! Hex OID of the commit that introduced these lines
    string commit_id;

    //! Author of the commit
    hash<GitSignatureInfo> author;

    //! Original start line number in the commit that introduced the lines
    int start_line;

    //! Number of lines in this hunk
    int lines;

    //! Final start line number in the current file
    int final_start_line;
}

//! Stash entry information as returned by @ref GitRepository::stashList() "stashList()"
/** @since git 1.0
*/
hashdecl Qore::Git::StashInfo {
    //! Stash index (0 = most recent)
    int index;

    //! Stash message
    string message;
}

//! Information about a single conflicting file in a merge
/** Provides all three versions of the conflicting file (ancestor, ours, theirs)
    as both binary and string data, plus commit metadata for both sides.

    @since git 1.0
*/
hashdecl Qore::Git::GitMergeConflict {
    //! The file path in conflict
    string path;

    //! Ancestor (common base) content as binary; @ref nothing if the file was added on both sides
    *binary ancestor_content;

    //! Ancestor content as a UTF-8 string; @ref nothing if the file was added on both sides
    *string ancestor_content_string;

    //! "Our" side content as binary; @ref nothing if the file was deleted on our side
    *binary ours_content;

    //! "Our" side content as a UTF-8 string; @ref nothing if the file was deleted on our side
    *string ours_content_string;

    //! "Their" side content as binary; @ref nothing if the file was deleted on their side
    *binary theirs_content;

    //! "Their" side content as a UTF-8 string; @ref nothing if the file was deleted on their side
    *string theirs_content_string;

    //! Commit info for our side (keys: id, message, summary, author_name, author_email, author_when)
    hash<auto> ours_commit;

    //! Commit info for their side (same structure as \c ours_commit)
    hash<auto> theirs_commit;
}

//! Result of a merge operation
/** @since git 1.0
*/
hashdecl Qore::Git::GitMergeResult {
    //! @ref True if the branches were already up-to-date (no merge needed)
    bool up_to_date = False;

    //! @ref True if a fast-forward merge was performed
    bool fast_forward = False;

    //! @ref True if conflicts were detected (some may have been resolved)
    bool conflicts = False;

    //! The hex OID of the merge commit; @ref nothing if unresolved conflicts remain
    *string commit_id;

    //! Unresolved conflicts (empty if all were resolved or no conflicts)
    list<hash<GitMergeConflict>> conflict_list;

    //! File paths that were auto-resolved or resolved by callback
    list<string> resolved_paths;
}

//! Git repository class providing access to a local git repository
/** @par Example:
    @code{.py}
GitRepository repo(".");
printf("HEAD: %s\n", repo.headCommitId());
    @endcode

    This class wraps libgit2's @c git_repository API and supports two modes of operation:

    - <b>Disk-backed mode</b>: Traditional git repository on the local filesystem.
      Created with the constructor or @ref init().
    - <b>Virtual/in-memory mode</b>: Git repository created with @ref createVirtual().
      The object database, reference database, config, and index live entirely in
      memory with no filesystem footprint. Ideal for applications like Qorus that
      store configuration in a database. If a remote is added (for @ref fetch() /
      @ref push()), the repository is transparently migrated to a private
      temporary on-disk repository, since libgit2's pack negotiation requires
      disk-backed object storage.

    Both modes share the virtual filesystem API (@ref writeFile(), @ref readFile(),
    @ref deleteFile(), @ref listFiles()) for manipulating file content.

    @since git 1.0
*/
qclass GitRepository [arg=QoreGitRepository* repo; ns=Qore::Git; dom=FILESYSTEM,NETWORK; flags=final];

//! Opens an existing git repository at the given path
/** @par Example:
    @code{.py}
GitRepository repo("/path/to/repo");
    @endcode

    @param path the path to the git repository (or any path within the working directory)

    @throw GIT-REPOSITORY-OPEN-ERROR failed to open repository
*/
GitRepository::constructor(string path) [flags=NAMED_ARGS] {
    ReferenceHolder<QoreGitRepository> repo(new QoreGitRepository(path->c_str(), xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_GITREPOSITORY, repo.release());
}

//! Initializes a new git repository at the given path
/** @par Example:
    @code{.py}
GitRepository repo = GitRepository::init("/path/to/new/repo");
    @endcode

    @param path the path where the repository should be initialized
    @param bare if @ref True "True", creates a bare repository (default @ref False "False")

    @return a new GitRepository object

    @throw GIT-REPOSITORY-INIT-ERROR failed to initialize repository
*/
static GitRepository GitRepository::init(string path, *bool bare) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    ReferenceHolder<QoreGitRepository> repo(new QoreGitRepository(path->c_str(), bare, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_GITREPOSITORY, getProgram()), xsink);
    rv->setPrivate(CID_GITREPOSITORY, repo.release());
    return rv.release();
}

//! Creates an in-memory virtual repository with no filesystem dependency
/** The object database, reference database, config, and index are held entirely
    in memory; nothing is written to disk. (If a remote is subsequently added,
    the repository is transparently migrated to a private temporary on-disk
    repository — see @ref connectRemote() and @ref addRemote() — because
    libgit2's fetch/push pack negotiation requires disk-backed object storage.)

    @par Example:
    @code{.py}
GitRepository repo = GitRepository::createVirtual();
repo.configSet("user.name", "Qorus");
repo.configSet("user.email", "qorus@example.com");
repo.writeFileString("config/db.yaml", "pool_size: 10\n");
string oid = repo.commit("Initial config");
    @endcode

    @return a new GitRepository object in virtual/in-memory mode

    @throw GIT-VIRTUAL-ERROR failed to create virtual repository
*/
static GitRepository GitRepository::createVirtual() {
    ReferenceHolder<QoreGitRepository> repo(new QoreGitRepository(true, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_GITREPOSITORY, getProgram()), xsink);
    rv->setPrivate(CID_GITREPOSITORY, repo.release());
    return rv.release();
}

//! Returns @ref True "True" if this is a virtual (in-memory) repository
/** @par Example:
    @code{.py}
if (repo.isVirtual()) {
    printf("This repo has no filesystem\n");
}
    @endcode

    @return @ref True "True" if this is a virtual repository
*/
bool GitRepository::isVirtual() [flags=CONSTANT] {
    return repo->isVirtual();
}

//! Reads file content from the current tree as binary data
/** @par Example:
    @code{.py}
*binary data = repo.readFile("config/db.yaml");
    @endcode

    @param path the file path within the repository

    @return the file content as binary data, or @ref nothing if the file does not exist

    @throw GIT-READ-ERROR failed to read file
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
*binary GitRepository::readFile(string path) [flags=NAMED_ARGS] {
    return repo->readFile(path->c_str(), xsink);
}

//! Reads file content from the current tree as a string
/** @par Example:
    @code{.py}
*string yaml = repo.readFileString("config/db.yaml");
    @endcode

    @param path the file path within the repository
    @param encoding the character encoding (default: UTF-8)

    @return the file content as a string, or @ref nothing if the file does not exist

    @throw GIT-READ-ERROR failed to read file
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
*string GitRepository::readFileString(string path, *string encoding) [flags=NAMED_ARGS] {
    return repo->readFileString(path->c_str(), encoding ? encoding->c_str() : nullptr, xsink);
}

//! Writes binary content to a file in the repository
/** In virtual mode, creates a blob in memory. In disk mode, writes to the working
    directory and stages the file.

    @par Example:
    @code{.py}
repo.writeFile("data/image.png", binary_data);
    @endcode

    @param path the file path within the repository
    @param content the binary content to write

    @throw GIT-WRITE-ERROR failed to write file
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::writeFile(string path, binary content) [flags=NAMED_ARGS] {
    repo->writeFile(path->c_str(), content->getPtr(), content->size(), xsink);
}

//! Writes string content to a file in the repository
/** In virtual mode, creates a blob in memory. In disk mode, writes to the working
    directory and stages the file.

    @par Example:
    @code{.py}
repo.writeFileString("config/db.yaml", "pool_size: 10\n");
    @endcode

    @param path the file path within the repository
    @param content the string content to write

    @throw GIT-WRITE-ERROR failed to write file
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::writeFileString(string path, string content) [flags=NAMED_ARGS] {
    repo->writeFileString(path->c_str(), content->c_str(), content->size(), xsink);
}

//! Deletes a file from the repository
/** In virtual mode, removes from the in-memory tree. In disk mode, deletes from
    the working directory and unstages.

    @par Example:
    @code{.py}
repo.deleteFile("config/old.yaml");
    @endcode

    @param path the file path within the repository

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::deleteFile(string path) [flags=NAMED_ARGS] {
    repo->deleteFile(path->c_str(), xsink);
}

//! Returns @ref True "True" if a file exists in the current tree
/** @par Example:
    @code{.py}
if (repo.fileExists("config/db.yaml")) {
    auto data = repo.readFileString("config/db.yaml");
}
    @endcode

    @param path the file path within the repository

    @return @ref True "True" if the file exists

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
bool GitRepository::fileExists(string path) [flags=NAMED_ARGS] {
    return repo->fileExists(path->c_str(), xsink);
}

//! Lists files in the current tree
/** @par Example:
    @code{.py}
list<string> files = repo.listFiles();
    @endcode

    @return a list of file paths in the repository

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
list<string> GitRepository::listFiles() {
    return repo->listFiles(nullptr, true, xsink);
}

//! Returns the path to the .git directory
/** @par Example:
    @code{.py}
string path = repo.path();
    @endcode

    @return the path to the .git directory

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
string GitRepository::path() {
    return repo->getPath(xsink);
}

//! Returns the path to the working directory, or @ref nothing for bare repos
/** @par Example:
    @code{.py}
*string workdir = repo.workdir();
    @endcode

    @return the working directory path, or @ref nothing for bare repositories

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
*string GitRepository::workdir() {
    return repo->getWorkdir(xsink);
}

//! Returns @ref True "True" if the repository is bare
/** @par Example:
    @code{.py}
bool bare = repo.isBare();
    @endcode

    @return @ref True "True" if the repository is bare

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
bool GitRepository::isBare() {
    return repo->isBare(xsink);
}

//! Returns @ref True "True" if the repository has no commits
/** @par Example:
    @code{.py}
bool empty = repo.isEmpty();
    @endcode

    @return @ref True "True" if the repository has no commits

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
bool GitRepository::isEmpty() {
    return repo->isEmpty(xsink);
}

//! Adds a file to the staging area (index) by path
/** @par Example:
    @code{.py}
repo.add("file.txt");
    @endcode

    @param path the file path relative to the working directory

    @throw GIT-INDEX-ERROR failed to add file to index
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::add(string path) [flags=NAMED_ARGS] {
    repo->addToIndex(path->c_str(), xsink);
}

//! Removes a file from the staging area (index) by path
/** @par Example:
    @code{.py}
repo.unstage("file.txt");
    @endcode

    @param path the file path relative to the working directory

    @throw GIT-INDEX-ERROR failed to remove file from index
    @throw GIT-REPOSITORY-ERROR repository has been closed
    @throw GIT-MODE-ERROR if called on a virtual repository
*/
nothing GitRepository::unstage(string path) [flags=NAMED_ARGS] {
    repo->removeFromIndex(path->c_str(), xsink);
}

//! Creates a commit from the current index state using the default signature
/** @par Example:
    @code{.py}
string oid = repo.commit("Initial commit");
    @endcode

    @param message the commit message

    @return the hex OID string of the new commit

    @throw GIT-COMMIT-ERROR failed to create commit
    @throw GIT-REPOSITORY-ERROR repository has been closed

    @note Requires user.name and user.email to be configured in git config.
    Use @ref configSet() to configure them.
*/
string GitRepository::commit(string message) [flags=NAMED_ARGS] {
    return repo->commit(message->c_str(), xsink);
}

//! Returns the hex OID of the HEAD commit, or @ref nothing for empty repos
/** @par Example:
    @code{.py}
*string head = repo.headCommitId();
    @endcode

    @return the hex OID string of the HEAD commit, or @ref nothing if the repository has no commits

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
*string GitRepository::headCommitId() {
    return repo->headCommitId(xsink);
}

//! Returns the status of the working directory as a hash mapping paths to status flags
/** @par Example:
    @code{.py}
hash<string, int> status = repo.status();
for (hash<auto> i in (status.pairIterator())) {
    printf("%s: %d\n", i.key, i.value);
}
    @endcode

    @return a hash mapping file paths to status flag integers; see @ref git_status_constants

    @throw GIT-STATUS-ERROR failed to get status
    @throw GIT-REPOSITORY-ERROR repository has been closed

    @see @ref GIT_STATUS_INDEX_NEW, @ref GIT_STATUS_WT_MODIFIED, etc.
*/
hash<string, int> GitRepository::status() {
    return repo->getStatus(xsink);
}

//! Sets a git configuration value for this repository
/** @par Example:
    @code{.py}
repo.configSet("user.name", "John Doe");
repo.configSet("user.email", "john@example.com");
    @endcode

    @param key the configuration key
    @param value the configuration value

    @throw GIT-CONFIG-ERROR failed to set config value
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::configSet(string key, string value) [flags=NAMED_ARGS] {
    repo->configSet(key->c_str(), value->c_str(), xsink);
}

//! Gets a git configuration value for this repository
/** @par Example:
    @code{.py}
*string name = repo.configGet("user.name");
    @endcode

    @param key the configuration key

    @return the configuration value, or @ref nothing if not found

    @throw GIT-CONFIG-ERROR failed to get config value
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
*string GitRepository::configGet(string key) [flags=NAMED_ARGS] {
    return repo->configGet(key->c_str(), xsink);
}

// --- Branch Operations ---

//! Creates a new branch
/** @par Example:
    @code{.py}
repo.createBranch("feature-x");
repo.createBranch("bugfix", "v1.0");  # branch from tag
    @endcode

    @param name the branch name
    @param from_ref optional ref to branch from (default: HEAD)

    @throw GIT-BRANCH-ERROR failed to create branch
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::createBranch(string name, *string from_ref) [flags=NAMED_ARGS] {
    repo->createBranch(name->c_str(), from_ref ? from_ref->c_str() : nullptr, xsink);
}

//! Deletes a local branch
/** @par Example:
    @code{.py}
repo.deleteBranch("feature-x");
    @endcode

    @param name the branch name

    @throw GIT-BRANCH-ERROR failed to delete branch (e.g., branch not found or is current)
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::deleteBranch(string name) [flags=NAMED_ARGS] {
    repo->deleteBranch(name->c_str(), xsink);
}

//! Checks out a branch or ref
/** In disk mode, updates the working directory. In virtual mode, populates the
    virtual tree from the ref's commit tree.

    @par Example:
    @code{.py}
repo.checkout("main");
repo.checkout("feature-x");
    @endcode

    @param ref the branch name, tag name, or commit SHA to checkout

    @throw GIT-CHECKOUT-ERROR failed to checkout
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::checkout(string ref) [flags=NAMED_ARGS] {
    repo->checkout(ref->c_str(), xsink);
}

//! Lists branches
/** @par Example:
    @code{.py}
list<string> local = repo.branches();
list<string> remote = repo.branches(True);
    @endcode

    @param remote if @ref True "True", list remote tracking branches instead of local

    @return a list of branch names

    @throw GIT-BRANCH-ERROR failed to list branches
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
list<string> GitRepository::branches(*bool remote) [flags=NAMED_ARGS] {
    return repo->listBranches(remote, xsink);
}

//! Returns the name of the current branch, or @ref nothing for detached HEAD
/** @par Example:
    @code{.py}
*string branch = repo.currentBranch();
    @endcode

    @return the current branch name, or @ref nothing if HEAD is detached

    @throw GIT-BRANCH-ERROR failed to get current branch
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
*string GitRepository::currentBranch() {
    return repo->currentBranch(xsink);
}

// --- Tag Operations ---

//! Creates a tag
/** If @a message is provided, creates an annotated tag; otherwise a lightweight tag.

    @par Example:
    @code{.py}
repo.createTag("v1.0", "Release 1.0");       # annotated tag at HEAD
repo.createTag("v0.9");                       # lightweight tag at HEAD
repo.createTag("v0.8", "Old release", "abc123");  # tag specific commit
    @endcode

    @param name the tag name
    @param message optional tag message (if provided, creates annotated tag)
    @param target_ref optional ref to tag (default: HEAD)

    @throw GIT-TAG-ERROR failed to create tag
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::createTag(string name, *string message, *string target_ref) [flags=NAMED_ARGS] {
    repo->createTag(name->c_str(),
                    message ? message->c_str() : nullptr,
                    target_ref ? target_ref->c_str() : nullptr, xsink);
}

//! Deletes a tag
/** @par Example:
    @code{.py}
repo.deleteTag("v1.0");
    @endcode

    @param name the tag name

    @throw GIT-TAG-ERROR failed to delete tag
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::deleteTag(string name) [flags=NAMED_ARGS] {
    repo->deleteTag(name->c_str(), xsink);
}

//! Lists all tags
/** @par Example:
    @code{.py}
list<string> tags = repo.tags();
    @endcode

    @return a list of tag names

    @throw GIT-TAG-ERROR failed to list tags
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
list<string> GitRepository::tags() {
    return repo->listTags(xsink);
}

// --- Diff & Log Operations ---

//! Returns a list of diff entries between two refs
/** If @a from_ref is not provided, diff starts from an empty tree (shows all files).
    If @a to_ref is not provided, diff is against HEAD.

    @par Example:
    @code{.py}
# diff between two branches
list<hash<auto>> changes = repo.diff("main", "feature");
for (hash<auto> entry in (changes)) {
    printf("%s: %s\n", entry.status, entry.path);
}
    @endcode

    @param from_ref the starting ref (branch, tag, or commit SHA)
    @param to_ref the ending ref (default: HEAD)

    @return a list of hashes with keys: \c status (string: "added", "deleted", "modified",
    "renamed"), \c path (string), and optionally \c old_path (string, for renames)

    @throw GIT-DIFF-ERROR failed to compute diff
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
list<hash<DiffEntry>> GitRepository::diff(*string from_ref, *string to_ref) [flags=NAMED_ARGS] {
    return repo->diff(from_ref ? from_ref->c_str() : nullptr,
                      to_ref ? to_ref->c_str() : nullptr, xsink);
}

//! Returns the diff as a unified patch string
/** @par Example:
    @code{.py}
string patch = repo.diffPatch("main", "feature");
printf("%s\n", patch);
    @endcode

    @param from_ref the starting ref
    @param to_ref the ending ref (default: HEAD)

    @return the diff in unified patch format

    @throw GIT-DIFF-ERROR failed to compute diff
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
string GitRepository::diffPatch(*string from_ref, *string to_ref) [flags=NAMED_ARGS] {
    return repo->diffPatch(from_ref ? from_ref->c_str() : nullptr,
                           to_ref ? to_ref->c_str() : nullptr, xsink);
}

//! Returns the commit log
/** @par Example:
    @code{.py}
list<hash<auto>> commits = repo.log(10);
for (hash<auto> c in (commits)) {
    printf("%s: %s\n", c.id.substr(0, 7), c.summary);
}

# filter by path
list<hash<auto>> file_log = repo.log(NOTHING, "config/db.yaml");
    @endcode

    @param max_count maximum number of commits to return (default: all)
    @param path optional path filter — only returns commits touching this path

    @return a list of hashes with keys: \c id (string), \c message (string),
    \c summary (string), \c author (hash with \c name, \c email, \c when),
    \c parent_count (int)

    @throw GIT-LOG-ERROR failed to traverse log
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
list<hash<CommitInfo>> GitRepository::log(*int max_count, *string path) [flags=NAMED_ARGS] {
    return repo->log((int)max_count,
                     path ? path->c_str() : nullptr, xsink);
}

// --- Remote / Network Operations ---

//! Adds a named remote to the repository
/** @par Example:
    @code{.py}
repo.addRemote("origin", "git@github.com:myorg/myrepo.git");
    @endcode

    @param name the remote name (e.g., "origin")
    @param url the remote URL

    @throw GIT-REMOTE-ERROR failed to add remote
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::addRemote(string name, string url) [dom=NETWORK;flags=NAMED_ARGS] {
    repo->addRemote(name->c_str(), url->c_str(), xsink);
}

//! Removes a named remote from the repository
/** @par Example:
    @code{.py}
repo.removeRemote("origin");
    @endcode

    @param name the remote name

    @throw GIT-REMOTE-ERROR failed to remove remote
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::removeRemote(string name) [flags=NAMED_ARGS] {
    repo->removeRemote(name->c_str(), xsink);
}

//! Fetches objects and refs from a remote
/** @par Example:
    @code{.py}
repo.fetch();                # fetch from "origin"
repo.fetch("upstream");      # fetch from named remote
    @endcode

    @param remote the remote name (default: "origin")

    @throw GIT-FETCH-ERROR failed to fetch
    @throw GIT-REPOSITORY-ERROR repository has been closed
    @throw NETWORK-ACCESS-DENIED the remote address is blocked by the active
    @ref Qore::SandboxManager "SandboxManager" network policy

    @note When a @ref Qore::SandboxManager "SandboxManager" is active, a
    best-effort pre-flight check resolves the remote host and validates each
    address against the network security policy (SSRF / private-network /
    cloud-metadata blocking) before connecting. This is advisory: libgit2
    performs its own independent resolution and connection, so DNS rebinding
    between the check and the connect, HTTP redirects, and proxies are not
    covered. Coarse all-or-nothing control is always enforced via the
    @c NETWORK functional domain.
*/
nothing GitRepository::fetch(*string remote) [dom=NETWORK;flags=NAMED_ARGS] {
    repo->fetch(remote ? remote->c_str() : nullptr, xsink);
}

//! Pushes commits to a remote
/** @par Example:
    @code{.py}
repo.push();                                  # push current branch to origin
repo.push("origin", "refs/heads/main:refs/heads/main");  # explicit refspec
    @endcode

    @param remote the remote name (default: "origin")
    @param refspec the refspec to push (default: current branch)

    @throw GIT-PUSH-ERROR failed to push
    @throw GIT-REPOSITORY-ERROR repository has been closed
    @throw NETWORK-ACCESS-DENIED the remote address is blocked by the active
    @ref Qore::SandboxManager "SandboxManager" network policy

    @note See @ref GitRepository::fetch() "fetch()" for details on the
    best-effort network sandbox pre-flight check.
*/
nothing GitRepository::push(*string remote, *string refspec) [dom=NETWORK;flags=NAMED_ARGS] {
    repo->push(remote ? remote->c_str() : nullptr,
               refspec ? refspec->c_str() : nullptr, xsink);
}

// --- Additional Query Methods ---

//! Looks up a commit by reference, branch name, tag, or OID
/** @par Example:
    @code{.py}
hash<CommitInfo> info = repo.lookupCommit("HEAD~3");
printf("commit %s by %s: %s\n", info.short_id, info.author.name, info.summary);
    @endcode

    @param ref the reference to resolve (branch, tag, SHA, HEAD~N, etc.)

    @return a @ref hash<CommitInfo> with commit details

    @throw GIT-COMMIT-ERROR failed to resolve reference or look up commit
    @throw GIT-REPOSITORY-ERROR repository has been closed

    @since git 1.0
*/
hash<CommitInfo> GitRepository::lookupCommit(string ref) [flags=RET_VALUE_ONLY,NAMED_ARGS] {
    return repo->lookupCommit(ref->c_str(), xsink);
}

//! Returns the current repository state
/** @par Example:
    @code{.py}
string state = repo.state();
if (state == "merge") {
    printf("Repository is in a merge state\n");
}
    @endcode

    @return one of: \c "none", \c "merge", \c "revert", \c "revert_sequence",
    \c "cherrypick", \c "cherrypick_sequence", \c "bisect", \c "rebase",
    \c "rebase_interactive", \c "rebase_merge", \c "apply_mailbox",
    \c "apply_mailbox_or_rebase"

    @throw GIT-REPOSITORY-ERROR repository has been closed

    @since git 1.0
*/
string GitRepository::state() [flags=RET_VALUE_ONLY] {
    return repo->getState(xsink);
}

//! Returns diff statistics between two refs
/** @par Example:
    @code{.py}
hash<DiffStatsInfo> stats = repo.diffStats("main", "feature");
printf("Changed: %d files, +%d -%d\n", stats.files_changed, stats.insertions, stats.deletions);
    @endcode

    @param from_ref the starting ref (default: empty tree)
    @param to_ref the ending ref (default: HEAD)

    @return a @ref hash<DiffStatsInfo> with files_changed, insertions, deletions

    @throw GIT-DIFF-ERROR failed to compute diff stats
    @throw GIT-REPOSITORY-ERROR repository has been closed

    @since git 1.0
*/
hash<DiffStatsInfo> GitRepository::diffStats(*string from_ref, *string to_ref) [flags=NAMED_ARGS] {
    return repo->diffStats(from_ref ? from_ref->c_str() : nullptr,
                           to_ref ? to_ref->c_str() : nullptr, xsink);
}

//! Returns blame information for a file
/** @par Example:
    @code{.py}
list<hash<BlameHunkInfo>> hunks = repo.blame("src/main.cpp");
for (hash<BlameHunkInfo> h in (hunks)) {
    printf("L%d-%d: %s (%s)\n", h.final_start_line,
        h.final_start_line + h.lines - 1, h.commit_id.substr(0, 7), h.author.name);
}
    @endcode

    @param path the file path to blame
    @param options optional options:
    - \c newest_commit (string): only consider commits up to this ref
    - \c oldest_commit (string): only consider commits from this ref

    @return a list of @ref hash<BlameHunkInfo> hunks

    @throw GIT-BLAME-ERROR failed to blame file
    @throw GIT-REPOSITORY-ERROR repository has been closed

    @since git 1.0
*/
list<hash<BlameHunkInfo>> GitRepository::blame(string path, *hash<auto> options) [flags=NAMED_ARGS] {
    return repo->blame(path->c_str(), options, xsink);
}

//! Saves the current working directory state to the stash (disk mode only)
/** @par Example:
    @code{.py}
string oid = repo.stash("Work in progress");
    @endcode

    @param message optional stash message

    @return the hex OID of the stash commit

    @throw GIT-STASH-ERROR failed to save stash or nothing to stash
    @throw GIT-MODE-ERROR called on a virtual repository
    @throw GIT-REPOSITORY-ERROR repository has been closed

    @since git 1.0
*/
string GitRepository::stash(*string message) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    return repo->stash(message ? message->c_str() : nullptr, xsink);
}

//! Pops the most recent stash entry and applies it (disk mode only)
/** @par Example:
    @code{.py}
repo.stashPop();
    @endcode

    @throw GIT-STASH-ERROR failed to pop stash
    @throw GIT-MODE-ERROR called on a virtual repository
    @throw GIT-REPOSITORY-ERROR repository has been closed

    @since git 1.0
*/
nothing GitRepository::stashPop() [dom=FILESYSTEM] {
    repo->stashPop(xsink);
}

//! Lists all stash entries (disk mode only)
/** @par Example:
    @code{.py}
list<hash<StashInfo>> stashes = repo.stashList();
for (hash<StashInfo> s in (stashes)) {
    printf("stash@{%d}: %s\n", s.index, s.message);
}
    @endcode

    @return a list of @ref hash<StashInfo> entries

    @throw GIT-STASH-ERROR failed to list stashes
    @throw GIT-MODE-ERROR called on a virtual repository
    @throw GIT-REPOSITORY-ERROR repository has been closed

    @since git 1.0
*/
list<hash<StashInfo>> GitRepository::stashList() [dom=FILESYSTEM] {
    return repo->stashList(xsink);
}

//! Creates a virtual repository connected to a remote
/** Convenience factory that creates a virtual repo, configures identity,
    adds the remote, fetches, and optionally checks out a branch.

    @note Because a remote is added, the repository is backed by a private
    temporary on-disk repository (created with mode 0700, honoring @c TMPDIR,
    and removed when the object is destroyed). libgit2's fetch/push pack
    negotiation requires disk-backed object storage; use @ref createVirtual()
    without a remote for a strictly in-memory repository.

    @par Example:
    @code{.py}
GitRepository repo = GitRepository::connectRemote("git@github.com:org/repo.git", {
    "identity": {"name": "Bot", "email": "bot@example.com"},
    "branch": "main",
});
*string content = repo.readFileString("config.yaml");
    @endcode

    @param url the remote URL
    @param options optional configuration:
    - \c identity (hash): \c name and \c email for commits
    - \c branch (string): branch to checkout after fetch

    @return a new GitRepository in virtual mode connected to the remote

    @throw GIT-VIRTUAL-ERROR failed to create virtual repository
    @throw GIT-REMOTE-ERROR failed to add remote
    @throw GIT-FETCH-ERROR failed to fetch from remote
    @throw GIT-CHECKOUT-ERROR failed to checkout branch
    @throw NETWORK-ACCESS-DENIED the remote address is blocked by the active
    @ref Qore::SandboxManager "SandboxManager" network policy (see
    @ref GitRepository::fetch() "fetch()")

    @since git 1.0
*/
static GitRepository GitRepository::connectRemote(string url, *hash<auto> options) [dom=NETWORK;flags=NAMED_ARGS] {
    // Create virtual repo
    ReferenceHolder<QoreGitRepository> repo(new QoreGitRepository(true, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    // Configure identity if provided
    if (options) {
        QoreValue id = options->getKeyValue("identity");
        if (id.getType() == NT_HASH) {
            const QoreHashNode* identity = id.get<const QoreHashNode>();
            QoreValue name_val = identity->getKeyValue("name");
            QoreValue email_val = identity->getKeyValue("email");
            if (name_val.getType() == NT_STRING) {
                QoreStringValueHelper name(name_val);
                repo->configSet("user.name", name->c_str(), xsink);
                if (*xsink) {
                    return QoreValue();
                }
            }
            if (email_val.getType() == NT_STRING) {
                QoreStringValueHelper email(email_val);
                repo->configSet("user.email", email->c_str(), xsink);
                if (*xsink) {
                    return QoreValue();
                }
            }
        }
    }

    // Add remote
    repo->addRemote("origin", url->c_str(), xsink);
    if (*xsink) {
        return QoreValue();
    }

    // Fetch
    repo->fetch(nullptr, xsink);
    if (*xsink) {
        return QoreValue();
    }

    // Checkout branch if specified, otherwise auto-detect
    bool has_branch = false;
    if (options) {
        QoreValue bv = options->getKeyValue("branch");
        if (bv.getType() == NT_STRING) {
            QoreStringValueHelper branch(bv);
            repo->checkout(branch->c_str(), xsink);
            if (*xsink) {
                return QoreValue();
            }
            has_branch = true;
        }
    }
    if (!has_branch) {
        // Auto-detect: checkout first remote branch
        ReferenceHolder<QoreListNode> branches(repo->listBranches(true, xsink), xsink);
        if (*xsink) {
            return QoreValue();
        }
        if (branches && branches->size() > 0) {
            QoreValue first_val = branches->retrieveEntry(0);
            if (first_val.getType() == NT_STRING) {
                QoreStringValueHelper first(first_val);
                repo->checkout(first->c_str(), xsink);
                if (*xsink) {
                    return QoreValue();
                }
            }
        }
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_GITREPOSITORY, getProgram()), xsink);
    rv->setPrivate(CID_GITREPOSITORY, repo.release());
    return rv.release();
}

// --- Merge & Pull Operations ---

//! Merges the specified ref into the current branch
/** Performs a git merge of the specified reference into the current HEAD.
    Supports multiple conflict resolution strategies via the \c options hash:
    - \c strategy (string): \c "detect" (default), \c "ours", \c "theirs", or \c "callback"
    - \c resolver (code): conflict resolver callback (required for \c "callback" strategy);
      receives a @ref hash<GitMergeConflict>, returns resolved content (string/binary) or @ref nothing
    - \c message (string): merge commit message (default: \c "Merge <ref>")
    - \c no_commit (bool): if @ref True, do not create a merge commit even if all conflicts are resolved

    @par Example:
    @code{.py}
# Simple merge with conflict detection
hash<GitMergeResult> result = repo.merge("origin/main");
if (result.conflicts) {
    for (hash<GitMergeConflict> c in (result.conflict_list)) {
        printf("Conflict in %s\n", c.path);
    }
}

# Auto-resolve preferring "theirs"
hash<GitMergeResult> result = repo.merge("feature", {"strategy": "theirs"});

# AI-based callback resolution
hash<GitMergeResult> result = repo.merge("feature", {
    "strategy": "callback",
    "resolver": sub (hash<GitMergeConflict> conflict) {
        return ai_resolve(conflict.ours_content_string, conflict.theirs_content_string);
    },
});
    @endcode

    @param ref the branch, tag, or commit SHA to merge
    @param options optional merge options hash

    @return a @ref hash<GitMergeResult> with the merge outcome

    @throw GIT-MERGE-ERROR failed to perform merge
    @throw GIT-MERGE-OPTION-ERROR invalid merge options (bad strategy or missing resolver)
    @throw GIT-REPOSITORY-ERROR repository has been closed

    @since git 1.0
*/
hash<GitMergeResult> GitRepository::merge(string ref, *hash<auto> options) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    return repo->merge(ref->c_str(), options, xsink);
}

//! Fetches from a remote and merges the tracking branch into the current branch
/** Equivalent to @ref fetch() followed by @ref merge() of the remote tracking branch.

    @par Example:
    @code{.py}
# Simple pull from origin
hash<GitMergeResult> result = repo.pull();

# Pull with AI conflict resolution
hash<GitMergeResult> result = repo.pull("origin", {
    "strategy": "callback",
    "resolver": \ai_resolver(),
});
    @endcode

    @param remote the remote name (default: "origin")
    @param options optional merge options hash (same keys as @ref merge())

    @return a @ref hash<GitMergeResult> with the merge outcome

    @throw GIT-FETCH-ERROR failed to fetch from remote
    @throw GIT-MERGE-ERROR failed to merge
    @throw GIT-PULL-ERROR failed to determine tracking branch or detached HEAD
    @throw GIT-REPOSITORY-ERROR repository has been closed
    @throw NETWORK-ACCESS-DENIED the remote address is blocked by the active
    @ref Qore::SandboxManager "SandboxManager" network policy (see
    @ref GitRepository::fetch() "fetch()")

    @since git 1.0
*/
hash<GitMergeResult> GitRepository::pull(*string remote, *hash<auto> options) [dom=NETWORK;flags=NAMED_ARGS] {
    return repo->pull(remote ? remote->c_str() : nullptr, options, xsink);
}
