#include "git-module.h"
#include "QoreGitRepository.h"

//! Git repository class providing access to a local git repository
/** @par Example:
    @code{.py}
GitRepository repo(".");
printf("HEAD: %s\n", repo.headCommitId());
    @endcode

    This class wraps libgit2's @c git_repository API and supports two modes of operation:

    - <b>Disk-backed mode</b>: Traditional git repository on the local filesystem.
      Created with the constructor or @ref init().
    - <b>Virtual/in-memory mode</b>: Git repository with no filesystem dependency.
      Created with @ref createVirtual(). All objects live in memory. Ideal for
      applications like Qorus that store configuration in a database.

    Both modes share the virtual filesystem API (@ref writeFile(), @ref readFile(),
    @ref deleteFile(), @ref listFiles()) for manipulating file content.

    @since git 1.0
*/
qclass GitRepository [arg=QoreGitRepository* repo; ns=Qore::Git; dom=FILESYSTEM,NETWORK; flags=final];

//! Opens an existing git repository at the given path
/** @par Example:
    @code{.py}
GitRepository repo("/path/to/repo");
    @endcode

    @param path the path to the git repository (or any path within the working directory)

    @throw GIT-REPOSITORY-OPEN-ERROR failed to open repository
*/
GitRepository::constructor(string path) {
    ReferenceHolder<QoreGitRepository> repo(new QoreGitRepository(path->c_str(), xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_GITREPOSITORY, repo.release());
}

//! Initializes a new git repository at the given path
/** @par Example:
    @code{.py}
GitRepository repo = GitRepository::init("/path/to/new/repo");
    @endcode

    @param path the path where the repository should be initialized
    @param bare if @ref True "True", creates a bare repository (default @ref False "False")

    @return a new GitRepository object

    @throw GIT-REPOSITORY-INIT-ERROR failed to initialize repository
*/
static GitRepository GitRepository::init(string path, *bool bare) [dom=FILESYSTEM] {
    ReferenceHolder<QoreGitRepository> repo(new QoreGitRepository(path->c_str(), bare, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_GITREPOSITORY, getProgram()), xsink);
    rv->setPrivate(CID_GITREPOSITORY, repo.release());
    return rv.release();
}

//! Creates an in-memory virtual repository with no filesystem dependency
/** @par Example:
    @code{.py}
GitRepository repo = GitRepository::createVirtual();
repo.configSet("user.name", "Qorus");
repo.configSet("user.email", "qorus@example.com");
repo.writeFileString("config/db.yaml", "pool_size: 10\n");
string oid = repo.commit("Initial config");
    @endcode

    @return a new GitRepository object in virtual/in-memory mode

    @throw GIT-VIRTUAL-ERROR failed to create virtual repository
*/
static GitRepository GitRepository::createVirtual() {
    ReferenceHolder<QoreGitRepository> repo(new QoreGitRepository(true, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }

    ReferenceHolder<QoreObject> rv(new QoreObject(QC_GITREPOSITORY, getProgram()), xsink);
    rv->setPrivate(CID_GITREPOSITORY, repo.release());
    return rv.release();
}

//! Returns @ref True "True" if this is a virtual (in-memory) repository
/** @par Example:
    @code{.py}
if (repo.isVirtual()) {
    printf("This repo has no filesystem\n");
}
    @endcode

    @return @ref True "True" if this is a virtual repository
*/
bool GitRepository::isVirtual() [flags=CONSTANT] {
    return repo->isVirtual();
}

//! Reads file content from the current tree as binary data
/** @par Example:
    @code{.py}
*binary data = repo.readFile("config/db.yaml");
    @endcode

    @param path the file path within the repository

    @return the file content as binary data, or @ref nothing if the file does not exist

    @throw GIT-READ-ERROR failed to read file
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
*binary GitRepository::readFile(string path) {
    return repo->readFile(path->c_str(), xsink);
}

//! Reads file content from the current tree as a string
/** @par Example:
    @code{.py}
*string yaml = repo.readFileString("config/db.yaml");
    @endcode

    @param path the file path within the repository
    @param encoding the character encoding (default: UTF-8)

    @return the file content as a string, or @ref nothing if the file does not exist

    @throw GIT-READ-ERROR failed to read file
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
*string GitRepository::readFileString(string path, *string encoding) {
    return repo->readFileString(path->c_str(), encoding ? encoding->c_str() : nullptr, xsink);
}

//! Writes binary content to a file in the repository
/** In virtual mode, creates a blob in memory. In disk mode, writes to the working
    directory and stages the file.

    @par Example:
    @code{.py}
repo.writeFile("data/image.png", binary_data);
    @endcode

    @param path the file path within the repository
    @param content the binary content to write

    @throw GIT-WRITE-ERROR failed to write file
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::writeFile(string path, binary content) {
    repo->writeFile(path->c_str(), content->getPtr(), content->size(), xsink);
}

//! Writes string content to a file in the repository
/** In virtual mode, creates a blob in memory. In disk mode, writes to the working
    directory and stages the file.

    @par Example:
    @code{.py}
repo.writeFileString("config/db.yaml", "pool_size: 10\n");
    @endcode

    @param path the file path within the repository
    @param content the string content to write

    @throw GIT-WRITE-ERROR failed to write file
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::writeFileString(string path, string content) {
    repo->writeFileString(path->c_str(), content->c_str(), content->size(), xsink);
}

//! Deletes a file from the repository
/** In virtual mode, removes from the in-memory tree. In disk mode, deletes from
    the working directory and unstages.

    @par Example:
    @code{.py}
repo.deleteFile("config/old.yaml");
    @endcode

    @param path the file path within the repository

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::deleteFile(string path) {
    repo->deleteFile(path->c_str(), xsink);
}

//! Returns @ref True "True" if a file exists in the current tree
/** @par Example:
    @code{.py}
if (repo.fileExists("config/db.yaml")) {
    auto data = repo.readFileString("config/db.yaml");
}
    @endcode

    @param path the file path within the repository

    @return @ref True "True" if the file exists

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
bool GitRepository::fileExists(string path) {
    return repo->fileExists(path->c_str(), xsink);
}

//! Lists files in the current tree
/** @par Example:
    @code{.py}
list<string> files = repo.listFiles();
    @endcode

    @return a list of file paths in the repository

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
list<string> GitRepository::listFiles() {
    return repo->listFiles(nullptr, true, xsink);
}

//! Returns the path to the .git directory
/** @par Example:
    @code{.py}
string path = repo.path();
    @endcode

    @return the path to the .git directory

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
string GitRepository::path() {
    return repo->getPath(xsink);
}

//! Returns the path to the working directory, or @ref nothing for bare repos
/** @par Example:
    @code{.py}
*string workdir = repo.workdir();
    @endcode

    @return the working directory path, or @ref nothing for bare repositories

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
*string GitRepository::workdir() {
    return repo->getWorkdir(xsink);
}

//! Returns @ref True "True" if the repository is bare
/** @par Example:
    @code{.py}
bool bare = repo.isBare();
    @endcode

    @return @ref True "True" if the repository is bare

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
bool GitRepository::isBare() {
    return repo->isBare(xsink);
}

//! Returns @ref True "True" if the repository has no commits
/** @par Example:
    @code{.py}
bool empty = repo.isEmpty();
    @endcode

    @return @ref True "True" if the repository has no commits

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
bool GitRepository::isEmpty() {
    return repo->isEmpty(xsink);
}

//! Adds a file to the staging area (index) by path
/** @par Example:
    @code{.py}
repo.add("file.txt");
    @endcode

    @param path the file path relative to the working directory

    @throw GIT-INDEX-ERROR failed to add file to index
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::add(string path) {
    repo->addToIndex(path->c_str(), xsink);
}

//! Removes a file from the staging area (index) by path
/** @par Example:
    @code{.py}
repo.unstage("file.txt");
    @endcode

    @param path the file path relative to the working directory

    @throw GIT-INDEX-ERROR failed to remove file from index
    @throw GIT-REPOSITORY-ERROR repository has been closed
    @throw GIT-MODE-ERROR if called on a virtual repository
*/
nothing GitRepository::unstage(string path) {
    repo->removeFromIndex(path->c_str(), xsink);
}

//! Creates a commit from the current index state using the default signature
/** @par Example:
    @code{.py}
string oid = repo.commit("Initial commit");
    @endcode

    @param message the commit message

    @return the hex OID string of the new commit

    @throw GIT-COMMIT-ERROR failed to create commit
    @throw GIT-REPOSITORY-ERROR repository has been closed

    @note Requires user.name and user.email to be configured in git config.
    Use @ref configSet() to configure them.
*/
string GitRepository::commit(string message) {
    return repo->commit(message->c_str(), xsink);
}

//! Returns the hex OID of the HEAD commit, or @ref nothing for empty repos
/** @par Example:
    @code{.py}
*string head = repo.headCommitId();
    @endcode

    @return the hex OID string of the HEAD commit, or @ref nothing if the repository has no commits

    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
*string GitRepository::headCommitId() {
    return repo->headCommitId(xsink);
}

//! Returns the status of the working directory as a hash mapping paths to status flags
/** @par Example:
    @code{.py}
hash<string, int> status = repo.status();
for (hash<auto> i in (status.pairIterator())) {
    printf("%s: %d\n", i.key, i.value);
}
    @endcode

    @return a hash mapping file paths to status flag integers; see @ref git_status_constants

    @throw GIT-STATUS-ERROR failed to get status
    @throw GIT-REPOSITORY-ERROR repository has been closed

    @see @ref GIT_STATUS_INDEX_NEW, @ref GIT_STATUS_WT_MODIFIED, etc.
*/
hash<string, int> GitRepository::status() {
    return repo->getStatus(xsink);
}

//! Sets a git configuration value for this repository
/** @par Example:
    @code{.py}
repo.configSet("user.name", "John Doe");
repo.configSet("user.email", "john@example.com");
    @endcode

    @param key the configuration key
    @param value the configuration value

    @throw GIT-CONFIG-ERROR failed to set config value
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::configSet(string key, string value) {
    repo->configSet(key->c_str(), value->c_str(), xsink);
}

//! Gets a git configuration value for this repository
/** @par Example:
    @code{.py}
*string name = repo.configGet("user.name");
    @endcode

    @param key the configuration key

    @return the configuration value, or @ref nothing if not found

    @throw GIT-CONFIG-ERROR failed to get config value
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
*string GitRepository::configGet(string key) {
    return repo->configGet(key->c_str(), xsink);
}

// --- Branch Operations ---

//! Creates a new branch
/** @par Example:
    @code{.py}
repo.createBranch("feature-x");
repo.createBranch("bugfix", "v1.0");  # branch from tag
    @endcode

    @param name the branch name
    @param from_ref optional ref to branch from (default: HEAD)

    @throw GIT-BRANCH-ERROR failed to create branch
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::createBranch(string name, *string from_ref) {
    repo->createBranch(name->c_str(), from_ref ? from_ref->c_str() : nullptr, xsink);
}

//! Deletes a local branch
/** @par Example:
    @code{.py}
repo.deleteBranch("feature-x");
    @endcode

    @param name the branch name

    @throw GIT-BRANCH-ERROR failed to delete branch (e.g., branch not found or is current)
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::deleteBranch(string name) {
    repo->deleteBranch(name->c_str(), xsink);
}

//! Checks out a branch or ref
/** In disk mode, updates the working directory. In virtual mode, populates the
    virtual tree from the ref's commit tree.

    @par Example:
    @code{.py}
repo.checkout("main");
repo.checkout("feature-x");
    @endcode

    @param ref the branch name, tag name, or commit SHA to checkout

    @throw GIT-CHECKOUT-ERROR failed to checkout
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::checkout(string ref) {
    repo->checkout(ref->c_str(), xsink);
}

//! Lists branches
/** @par Example:
    @code{.py}
list<string> local = repo.branches();
list<string> remote = repo.branches(True);
    @endcode

    @param remote if @ref True "True", list remote tracking branches instead of local

    @return a list of branch names

    @throw GIT-BRANCH-ERROR failed to list branches
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
list<string> GitRepository::branches(*bool remote) {
    return repo->listBranches(remote, xsink);
}

//! Returns the name of the current branch, or @ref nothing for detached HEAD
/** @par Example:
    @code{.py}
*string branch = repo.currentBranch();
    @endcode

    @return the current branch name, or @ref nothing if HEAD is detached

    @throw GIT-BRANCH-ERROR failed to get current branch
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
*string GitRepository::currentBranch() {
    return repo->currentBranch(xsink);
}

// --- Tag Operations ---

//! Creates a tag
/** If @a message is provided, creates an annotated tag; otherwise a lightweight tag.

    @par Example:
    @code{.py}
repo.createTag("v1.0", "Release 1.0");       # annotated tag at HEAD
repo.createTag("v0.9");                       # lightweight tag at HEAD
repo.createTag("v0.8", "Old release", "abc123");  # tag specific commit
    @endcode

    @param name the tag name
    @param message optional tag message (if provided, creates annotated tag)
    @param target_ref optional ref to tag (default: HEAD)

    @throw GIT-TAG-ERROR failed to create tag
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::createTag(string name, *string message, *string target_ref) {
    repo->createTag(name->c_str(),
                    message ? message->c_str() : nullptr,
                    target_ref ? target_ref->c_str() : nullptr, xsink);
}

//! Deletes a tag
/** @par Example:
    @code{.py}
repo.deleteTag("v1.0");
    @endcode

    @param name the tag name

    @throw GIT-TAG-ERROR failed to delete tag
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::deleteTag(string name) {
    repo->deleteTag(name->c_str(), xsink);
}

//! Lists all tags
/** @par Example:
    @code{.py}
list<string> tags = repo.tags();
    @endcode

    @return a list of tag names

    @throw GIT-TAG-ERROR failed to list tags
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
list<string> GitRepository::tags() {
    return repo->listTags(xsink);
}

// --- Diff & Log Operations ---

//! Returns a list of diff entries between two refs
/** If @a from_ref is not provided, diff starts from an empty tree (shows all files).
    If @a to_ref is not provided, diff is against HEAD.

    @par Example:
    @code{.py}
# diff between two branches
list<hash<auto>> changes = repo.diff("main", "feature");
for (hash<auto> entry in (changes)) {
    printf("%s: %s\n", entry.status, entry.path);
}
    @endcode

    @param from_ref the starting ref (branch, tag, or commit SHA)
    @param to_ref the ending ref (default: HEAD)

    @return a list of hashes with keys: \c status (string: "added", "deleted", "modified",
    "renamed"), \c path (string), and optionally \c old_path (string, for renames)

    @throw GIT-DIFF-ERROR failed to compute diff
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
list<hash<auto>> GitRepository::diff(*string from_ref, *string to_ref) {
    return repo->diff(from_ref ? from_ref->c_str() : nullptr,
                      to_ref ? to_ref->c_str() : nullptr, xsink);
}

//! Returns the diff as a unified patch string
/** @par Example:
    @code{.py}
string patch = repo.diffPatch("main", "feature");
printf("%s\n", patch);
    @endcode

    @param from_ref the starting ref
    @param to_ref the ending ref (default: HEAD)

    @return the diff in unified patch format

    @throw GIT-DIFF-ERROR failed to compute diff
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
string GitRepository::diffPatch(*string from_ref, *string to_ref) {
    return repo->diffPatch(from_ref ? from_ref->c_str() : nullptr,
                           to_ref ? to_ref->c_str() : nullptr, xsink);
}

//! Returns the commit log
/** @par Example:
    @code{.py}
list<hash<auto>> commits = repo.log(10);
for (hash<auto> c in (commits)) {
    printf("%s: %s\n", c.id.substr(0, 7), c.summary);
}

# filter by path
list<hash<auto>> file_log = repo.log(NOTHING, "config/db.yaml");
    @endcode

    @param max_count maximum number of commits to return (default: all)
    @param path optional path filter — only returns commits touching this path

    @return a list of hashes with keys: \c id (string), \c message (string),
    \c summary (string), \c author (hash with \c name, \c email, \c when),
    \c parent_count (int)

    @throw GIT-LOG-ERROR failed to traverse log
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
list<hash<auto>> GitRepository::log(*int max_count, *string path) {
    return repo->log((int)max_count,
                     path ? path->c_str() : nullptr, xsink);
}

// --- Remote / Network Operations ---

//! Adds a named remote to the repository
/** @par Example:
    @code{.py}
repo.addRemote("origin", "git@github.com:myorg/myrepo.git");
    @endcode

    @param name the remote name (e.g., "origin")
    @param url the remote URL

    @throw GIT-REMOTE-ERROR failed to add remote
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::addRemote(string name, string url) [dom=NETWORK] {
    repo->addRemote(name->c_str(), url->c_str(), xsink);
}

//! Removes a named remote from the repository
/** @par Example:
    @code{.py}
repo.removeRemote("origin");
    @endcode

    @param name the remote name

    @throw GIT-REMOTE-ERROR failed to remove remote
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::removeRemote(string name) {
    repo->removeRemote(name->c_str(), xsink);
}

//! Fetches objects and refs from a remote
/** @par Example:
    @code{.py}
repo.fetch();                # fetch from "origin"
repo.fetch("upstream");      # fetch from named remote
    @endcode

    @param remote the remote name (default: "origin")

    @throw GIT-FETCH-ERROR failed to fetch
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::fetch(*string remote) [dom=NETWORK] {
    repo->fetch(remote ? remote->c_str() : nullptr, xsink);
}

//! Pushes commits to a remote
/** @par Example:
    @code{.py}
repo.push();                                  # push current branch to origin
repo.push("origin", "refs/heads/main:refs/heads/main");  # explicit refspec
    @endcode

    @param remote the remote name (default: "origin")
    @param refspec the refspec to push (default: current branch)

    @throw GIT-PUSH-ERROR failed to push
    @throw GIT-REPOSITORY-ERROR repository has been closed
*/
nothing GitRepository::push(*string remote, *string refspec) [dom=NETWORK] {
    repo->push(remote ? remote->c_str() : nullptr,
               refspec ? refspec->c_str() : nullptr, xsink);
}
